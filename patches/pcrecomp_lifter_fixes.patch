--- a/tools/lift/lift32.py
+++ b/tools/lift/lift32.py
@@ -134,6 +134,56 @@ SETCC_MAP = {f'set{k[1:]}': v for k, v in COND_MAP.items()}
 # CMOVcc follows same pattern
 CMOVCC_MAP = {f'cmov{k[1:]}': v for k, v in COND_MAP.items()}
 
+# Flag analysis constants for Dead Flag Elimination (DFE)
+FLAG_CONSUMERS = set(COND_CODE.keys()) | set(SETCC_MAP.keys()) | set(CMOVCC_MAP.keys()) | {
+    'je', 'jne', 'jz', 'jnz', 'ja', 'jae', 'jb', 'jbe',
+    'jg', 'jge', 'jl', 'jle', 'js', 'jns', 'jo', 'jno',
+    'jp', 'jnp', 'jcxz', 'jecxz',
+    'adc', 'sbb', 'pushf', 'pushfd', 'lahf',
+}
+
+FLAG_FULL_CLOBBERS = {
+    'cmp', 'test', 'and', 'or', 'xor', 'add', 'sub', 'neg',
+    'popf', 'popfd', 'sahf',
+}
+
+FLAG_SETTERS = {
+    'add', 'sub', 'inc', 'dec', 'neg', 'and', 'or', 'xor',
+    'shl', 'sal', 'shr', 'sar', 'rol', 'ror', 'cmp', 'test', 'bt',
+}
+
+
+def analyze_flag_liveness(instructions, leaders: set = None) -> list[bool]:
+    """Compute whether each instruction's flag outputs are needed.
+    Returns a list of bools corresponding 1:1 with instructions."""
+    leaders = leaders or set()
+    n = len(instructions)
+    needed = [True] * n
+    for i, insn in enumerate(instructions):
+        if insn.mnemonic not in FLAG_SETTERS:
+            continue
+        is_needed = True
+        for j in range(i + 1, n):
+            nxt = instructions[j]
+            # Stop if entering a new basic block / merge point
+            if nxt.address in leaders:
+                is_needed = True
+                break
+            # Check if flags are read
+            if nxt.mnemonic in FLAG_CONSUMERS:
+                is_needed = True
+                break
+            # Check if flags are unconditionally overwritten or discarded at exit
+            if nxt.mnemonic in FLAG_FULL_CLOBBERS or nxt.is_ret or nxt.mnemonic == 'int3':
+                is_needed = False
+                break
+            # Stop at branch instructions
+            if getattr(nxt, 'is_uncond_jump', False) or getattr(nxt, 'is_cond_jump', False):
+                is_needed = True
+                break
+        needed[i] = is_needed
+    return needed
+
 
 def reg_name(reg_id: int) -> str:
     """Get the C variable name for a Capstone register ID."""
