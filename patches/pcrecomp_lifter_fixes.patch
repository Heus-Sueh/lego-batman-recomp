diff --git a/runtime/recomp32/recomp_types.h b/runtime/recomp32/recomp_types.h
index 482aaca..d2573a6 100644
--- a/runtime/recomp32/recomp_types.h
+++ b/runtime/recomp32/recomp_types.h
@@ -11,6 +11,7 @@
 #define RECOMP_TYPES_H
 
 #include <stdint.h>
+#include <stddef.h>
 #include <stdlib.h>
 #include <string.h>
 #include <stdio.h>
@@ -20,6 +21,10 @@
 #include <intrin.h>
 #endif
 
+#ifdef __cplusplus
+extern "C" {
+#endif
+
 /* ============================================================
  * Global Register Model
  *
@@ -161,7 +166,7 @@ static inline void MEMSET16(void* dst, uint16_t val, uint32_t count) {
     MEM32(sp) = _pv; \
 } while(0)
 
-#define POP32_VAL(sp) ({ \
+#define POP32_VAL(sp) __extension__({ \
     uint32_t _v = MEM32(sp); \
     (sp) += 4; \
     _v; \
@@ -752,7 +757,38 @@ recomp_func_t recomp_lookup_import(uint32_t va);    /* import bridges */
     g_cur_func = _caller;  /* the callee RECOMP_ENTER clobbered it */ \
 } while(0)
 
+static inline void recomp_log_unresolved_icall(uint32_t va, uint32_t caller) {
+    static uint32_t s_seen_vas[512];
+    static uint32_t s_seen_cnt = 0;
+    for (uint32_t i = 0; i < s_seen_cnt && i < 512; ++i) {
+        if (s_seen_vas[i] == va) return;
+    }
+    if (s_seen_cnt < 512) {
+        s_seen_vas[s_seen_cnt++] = va;
+    }
+    fprintf(stderr, "ICALL: unresolved VA 0x%08X from 0x%08X\n", va, caller);
+}
+
+static inline void recomp_log_unresolved_itail(uint32_t va, uint32_t caller) {
+    static uint32_t s_seen_vas[512];
+    static uint32_t s_seen_cnt = 0;
+    for (uint32_t i = 0; i < s_seen_cnt && i < 512; ++i) {
+        if (s_seen_vas[i] == va) return;
+    }
+    if (s_seen_cnt < 512) {
+        s_seen_vas[s_seen_cnt++] = va;
+    }
+    fprintf(stderr, "ITAIL: unresolved VA 0x%08X from 0x%08X\n", va, caller);
+}
+
 /* Indirect call through dispatch */
+#ifdef RECOMP_RUNTIME_DIAGNOSTICS
+void recomp_runtime_unresolved(uint32_t target, uint32_t caller);
+#define RECOMP_UNKNOWN_TARGET(target, caller) recomp_runtime_unresolved(target, caller)
+#else
+#define RECOMP_UNKNOWN_TARGET(target, caller) abort()
+#endif
+
 #define RECOMP_ICALL(target_va) do { \
     uint32_t _va = (uint32_t)(target_va); \
     g_icall_trace[g_icall_trace_idx & (ICALL_TRACE_SIZE-1)] = _va; \
@@ -767,9 +803,8 @@ recomp_func_t recomp_lookup_import(uint32_t va);    /* import bridges */
         _fn(); \
         g_cur_func = _caller;  /* the callee RECOMP_ENTER clobbered it */ \
     } else { \
-        fprintf(stderr, "ICALL: unresolved VA 0x%08X from 0x%08X\n", _va, g_cur_func); \
-        esp += 4; /* pop dummy ret addr */ \
-        eax = 0; \
+        recomp_log_unresolved_icall(_va, g_cur_func); \
+        RECOMP_UNKNOWN_TARGET(_va, g_cur_func); \
     } \
 } while(0)
 
@@ -785,7 +820,10 @@ recomp_func_t recomp_lookup_import(uint32_t va);    /* import bridges */
     if (_fn) { _fn(); } \
     else if (_va == RECOMP_RETADDR) { /* setjmp and friends return by jumping \
         to the saved return address; that is a return, not a missing target. */ } \
-    else { fprintf(stderr, "ITAIL: unresolved VA 0x%08X from 0x%08X\n", _va, g_cur_func); } \
+    else { \
+        recomp_log_unresolved_itail(_va, g_cur_func); \
+        RECOMP_UNKNOWN_TARGET(_va, g_cur_func); \
+    } \
 } while(0)
 
 /* ============================================================
@@ -818,4 +856,8 @@ void recomp_dump_trace(const char* why);
     if (!_warned) { fprintf(stderr, "STUB: %s called\n", name); _warned = 1; } \
 } while(0)
 
+#ifdef __cplusplus
+}
+#endif
+
 #endif /* RECOMP_TYPES_H */
