     # Ensure function doesn't fall off the end without return
@@ -207,6 +209,33 @@ def lift_function_linear(lifter, name, instructions, leaders, func_start):
     for lbl in sorted(refed - set(defined)):
         lines.append(f'    {lbl}: RECOMP_ITAIL(0x{int(lbl[2:], 16):08X}u); return;')
 
+    is_leaf = not any(
+        ('RECOMP_CALL' in l or 'RECOMP_ICALL' in l or 'RECOMP_ITAIL' in l)
+        for l in lines
+    )
+    if is_leaf:
+        prologue = [
+            '    /* Leaf function: register promotion to host local variables */',
+            '    uint32_t g_eax = ::g_eax, g_ecx = ::g_ecx, g_edx = ::g_edx, g_ebx = ::g_ebx;',
+            '    uint32_t g_esi = ::g_esi, g_edi = ::g_edi, g_ebp = ::g_ebp, g_esp = ::g_esp;',
+        ]
+        enter_idx = 0
+        for idx, l in enumerate(lines):
+            if 'RECOMP_ENTER(' in l:
+                enter_idx = idx + 1
+                break
+        for p in reversed(prologue):
+            lines.insert(enter_idx, p)
+
+        for idx in range(enter_idx + len(prologue), len(lines)):
+            if 'return;' in lines[idx] and not lines[idx].strip().startswith('/*'):
+                lines[idx] = lines[idx].replace('return;', 'goto _leaf_epilogue;')
+
+        lines.append('  _leaf_epilogue:')
+        lines.append('    ::g_eax = g_eax; ::g_ecx = g_ecx; ::g_edx = g_edx; ::g_ebx = g_ebx;')
+        lines.append('    ::g_esi = g_esi; ::g_edi = g_edi; ::g_ebp = g_ebp; ::g_esp = g_esp;')
+        lines.append('    return;')
+
     lines.append('}')
     out = '\n'.join(lines)
     return re.sub(r'CMP_(\w+)\(_fpu_cmp\)',
diff --git a/tools/lift/lift32.py b/tools/lift/lift32.py
