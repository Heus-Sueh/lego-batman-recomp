# Source-level guard complements isolated linking with PCRECOMP_BUILD_GAME=OFF.
foreach(layer libpcrecomp pcmodern win32compat)
    if(NOT EXISTS "${ROOT}/${layer}/CMakeLists.txt")
        message(FATAL_ERROR "Missing layer root: ${ROOT}/${layer}")
    endif()
    file(GLOB_RECURSE files "${ROOT}/${layer}/include/*.h" "${ROOT}/${layer}/src/*.cpp")
    foreach(path IN LISTS files)
        file(READ "${path}" source)
        if(source MATCHES "#[ \t]*include[^\n]*(SDL|generated/|src/runtime/|src/platform/|src/win32/|recomp_types)")
            message(FATAL_ERROR "Forbidden project/backend dependency: ${path}")
        endif()
        if(layer STREQUAL "pcmodern" AND source MATCHES "#[ \t]*include[^\n]*(pcrecomp/|win32compat/)")
            message(FATAL_ERROR "Reverse runtime dependency: ${path}")
        endif()
        if(layer STREQUAL "win32compat" AND source MATCHES "#[ \t]*include[^\n]*pcrecomp/")
            message(FATAL_ERROR "Win32 semantics depend on generated-code ABI: ${path}")
        endif()
    endforeach()
endforeach()
